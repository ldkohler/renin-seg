#!/usr/bin/env python3
"""
YOLOv5 Detection Node for ROS Melodic + Jetson
"""

import sys
import os

# Add yolov5 to path
sys.path.insert(0, os.path.expanduser('~/yolov5'))

import rospy
from sensor_msgs.msg import Image
from std_msgs.msg import String
import cv2
import numpy as np
import json
import torch

class YOLOv5Detector:
    def __init__(self):
        rospy.init_node('yolo_detector', anonymous=True)
        
        # Load YOLOv5 model
        model_path = os.path.expanduser('~/yolov5')
        weights_path = os.path.join(model_path, 'yolov5n.pt')
        
        rospy.loginfo("Loading YOLOv5 model...")
        self.model = torch.hub.load(model_path, 'custom', path=weights_path, source='local')
        self.model.conf = 0.5
        rospy.loginfo("Model loaded!")
        
        # Topic names
        self.image_topic = rospy.get_param('~image_topic', '/camera/color/image_raw')
        
        # Publishers
        self.detection_pub = rospy.Publisher('/yolo/detections', String, queue_size=10)
        self.image_pub = rospy.Publisher('/yolo/image_annotated', Image, queue_size=1)
        
        # Subscriber
        self.image_sub = rospy.Subscriber(
            self.image_topic,
            Image,
            self.image_callback,
            queue_size=1,
            buff_size=2**24
        )
        
        rospy.loginfo(f"Listening on: {self.image_topic}")

    def imgmsg_to_cv2(self, msg):
        """Convert ROS Image to OpenCV without cv_bridge"""
        buf = np.frombuffer(msg.data, dtype=np.uint8).reshape(msg.height, msg.width, -1)
        if msg.encoding == 'rgb8':
            return cv2.cvtColor(buf, cv2.COLOR_RGB2BGR)
        elif msg.encoding == 'bgr8':
            return buf
        elif msg.encoding == 'mono8':
            return cv2.cvtColor(buf, cv2.COLOR_GRAY2BGR)
        else:
            rospy.logwarn(f"Unknown encoding: {msg.encoding}, assuming BGR")
            return buf

    def cv2_to_imgmsg(self, cv_image, header=None):
        """Convert OpenCV image to ROS Image"""
        msg = Image()
        msg.height, msg.width = cv_image.shape[:2]
        msg.encoding = 'bgr8'
        msg.data = cv_image.tobytes()
        msg.step = msg.width * 3
        if header:
            msg.header = header
        return msg

    def image_callback(self, msg):
        try:
            cv_image = self.imgmsg_to_cv2(msg)
            
            # YOLOv5 inference
            results = self.model(cv_image)
            
            # Parse detections
            detections = []
            for *xyxy, conf, cls in results.xyxy[0].cpu().numpy():
                detections.append({
                    'class': self.model.names[int(cls)],
                    'confidence': round(float(conf), 3),
                    'bbox': [round(float(x), 1) for x in xyxy]
                })
            
            # Publish JSON detections
            self.detection_pub.publish(json.dumps(detections))
            
            # Publish annotated image
            annotated = np.squeeze(results.render())
            self.image_pub.publish(self.cv2_to_imgmsg(annotated, msg.header))
            
            if detections:
                classes = [d['class'] for d in detections]
                rospy.loginfo_throttle(1.0, f"Detected: {classes}")
                
        except Exception as e:
            rospy.logerr(f"Detection error: {e}")

    def run(self):
        rospy.spin()

if __name__ == '__main__':
    try:
        detector = YOLOv5Detector()
        detector.run()
    except rospy.ROSInterruptException:
        pass
